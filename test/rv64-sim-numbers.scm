;; Numeric helpers of the standalone RV64 simulator.
(import (scheme base) (scheme char) (scheme read) (scheme write)
        (scheme file) (scheme process-context) (skint) (skint hidden))
(include "rv64-sim.scm")
(define (check name actual expected)
  (if (not (equal? actual expected))
      (begin (display "[FAIL] ") (display name) (display ": ")
             (write actual) (display " expected ") (write expected) (newline)
             (exit 1))))
(check "little endian" (rv-int->le-bytes -2 4) '(254 255 255 255))
(check "align" (rv-align-up 17 16) 32)
(check "f32 one" (rv-flonum->ieee32-bits 1.0) #x3f800000)
(check "f32 negative zero" (rv-flonum->ieee32-bits -0.0) #x80000000)
(check "f32 infinity" (rv-flonum->ieee32-bits +inf.0) #x7f800000)
(check "f32 ties-even down" (rv-flonum->ieee32-bits (+ 1.0 (expt 2.0 -24))) #x3f800000)
(check "f32 ties-even up" (rv-flonum->ieee32-bits (+ 1.0 (* 3.0 (expt 2.0 -24)))) #x3f800002)
(check "f32 smallest subnormal" (rv-flonum->ieee32-bits (expt 2.0 -149)) 1)
(check "f32 rounds to infinity" (rv-flonum->ieee32-bits (expt 2.0 128)) #x7f800000)
(check "f64 one" (rv-flonum->ieee64-bits 1.0) #x3ff0000000000000)
(check "f64 negative zero" (rv-flonum->ieee64-bits -0.0) #x8000000000000000)
(check "f64 smallest subnormal" (rv-flonum->ieee64-bits (expt 2.0 -1074)) 1)
(display "[PASS] RV64 simulator numeric helpers\n")
