;; Grouped declarations have exactly the behavior of separate declarations.
(module $grouped_locals
  (macro $is-null ($value)
    (effect () -> (i32))
    (ptr.eqz $value))

  (func $check (export "check") (result i32)
    (frame 16)
    (local $p $q $r ptr)
    (local $i $j $k i32)
    (local $x $y i64)
    (local $f $g f32)
    (local $d $e f64)
    (local $single i32)
    ;; Every declared name is initially zero, including the third in a group.
    (if (i32.eqz ($is-null (local.get $p))) (then (return (i32.const 1))))
    (if (i32.eqz (ptr.eqz (local.get $q))) (then (return (i32.const 2))))
    (if (i32.eqz (ptr.eqz (local.get $r))) (then (return (i32.const 3))))
    (if (local.get $k) (then (return (i32.const 4))))
    (if (i64.ne (local.get $y) (i64.const 0)) (then (return (i32.const 5))))
    (if (f32.ne (local.get $g) (f32.const 0.0)) (then (return (i32.const 6))))
    (if (f64.ne (local.get $e) (f64.const 0.0)) (then (return (i32.const 7))))
    (local.set $p (frame.addr 0))
    (local.set $q (ptr.add (local.get $p) (i32.const 4)))
    (local.set $r (local.get $q))
    (if (ptr.ne (local.get $r) (local.get $q)) (then (return (i32.const 8))))
    (local.set $i (i32.const 17))
    (local.set $j (i32.const 25))
    (local.set $k (i32.add (local.get $i) (local.get $j)))
    (local.set $single (local.get $k))
    (if (i32.ne (local.get $single) (i32.const 42)) (then (return (i32.const 9))))
    (local.set $x (i64.const 100))
    (local.set $y (i64.add (local.get $x) (i64.const 23)))
    (if (i64.ne (local.get $y) (i64.const 123)) (then (return (i32.const 10))))
    (local.set $f (f32.const 1.5))
    (local.set $g (local.get $f))
    (if (f32.ne (local.get $g) (f32.const 1.5)) (then (return (i32.const 11))))
    (local.set $d (f64.const 1.5))
    (local.set $e (f64.add (local.get $d) (f64.const 0.5)))
    (if (f64.ne (local.get $e) (f64.const 2.0)) (then (return (i32.const 12))))
    (return (i32.const 0)))
  (func $main (export "main") (param $argc i32) (param $argv ptr) (result i32)
    (return (call $check))))
